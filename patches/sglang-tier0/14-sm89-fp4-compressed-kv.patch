+def sm89_fp4_compressed_kv() -> bool:
+    """SGLANG_SM89_FP4_COMPRESSED_KV=1: on SM89 the ratio-1/2 compressed caches keep the
+    reference's e2m1 values (V41_FP4) next to the V4 main cache, instead of being rounded
+    again into the V4 layout."""
+    return os.environ.get("SGLANG_SM89_FP4_COMPRESSED_KV", "0") == "1"
+
