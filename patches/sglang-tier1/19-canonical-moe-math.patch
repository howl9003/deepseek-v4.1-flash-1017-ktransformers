+"""Placement-independent MXFP4 expert math for the AVX2 eight-part layout.
+
+Each route produces one unweighted BF16 expert result. All backends must use
+the same route representation; combine_routes applies the original weights
+in logical top-k order, with one final BF16 cast. This is an opt-in numerical
+contract, not a drop-in change to already-weighted branch outputs.
+"""
+import torch
+import triton
+import triton.language as tl
+import triton.language.extra.cuda.libdevice as libdevice
+
+
+@triton.jit
+def _fp4(code):
+    mag = code & 7
+    value = tl.where(mag < 4, mag.to(tl.float32) * 0.5,
+                     tl.where(mag == 4, 2., tl.where(mag == 5, 3., tl.where(mag == 6, 4., 6.))))
+    return tl.where((code & 8) != 0, -value, value)
+
+
+@triton.jit
+def _sum8(v, BN: tl.constexpr):
+    v0 = tl.reshape(tl.gather(v, tl.full((BN, 1), 0, tl.int32), 1), (BN,))
+    v1 = tl.reshape(tl.gather(v, tl.full((BN, 1), 1, tl.int32), 1), (BN,))
+    v2 = tl.reshape(tl.gather(v, tl.full((BN, 1), 2, tl.int32), 1), (BN,))
+    v3 = tl.reshape(tl.gather(v, tl.full((BN, 1), 3, tl.int32), 1), (BN,))
+    v4 = tl.reshape(tl.gather(v, tl.full((BN, 1), 4, tl.int32), 1), (BN,))
+    v5 = tl.reshape(tl.gather(v, tl.full((BN, 1), 5, tl.int32), 1), (BN,))
+    v6 = tl.reshape(tl.gather(v, tl.full((BN, 1), 6, tl.int32), 1), (BN,))
+    v7 = tl.reshape(tl.gather(v, tl.full((BN, 1), 7, tl.int32), 1), (BN,))
+    # Exactly hsum_avx2: low+high, then pairs 0+2 and 1+3.
+    return ((v0 + v4) + (v2 + v6)) + ((v1 + v5) + (v3 + v7))
+
+
+@triton.jit
+def _activation(g, u, LIMIT: tl.constexpr):
+    g = tl.minimum(g, LIMIT)
+    u = tl.maximum(tl.minimum(u, LIMIT), -LIMIT)
+    x = tl.minimum(0. - g, 88.)
+    y = x * 1.44269504089
+    integer = libdevice.nearbyint(y).to(tl.int32)
+    fraction = y - integer.to(tl.float32)
+    p = tl.fma(0.0013333558, fraction, 0.0096181291)
+    p = tl.fma(p, fraction, 0.0555041087)
+    p = tl.fma(p, fraction, 0.2402265069)
+    p = tl.fma(p, fraction, 0.6931471805)
+    p = tl.fma(p, fraction, 0.9999999995)
+    bits = (tl.maximum(tl.minimum(integer, 127), -126) + 127) << 23
+    ex = bits.to(tl.float32, bitcast=True) * p
+    return libdevice.div_rn(g, 1. + ex) * u
+
+
+@triton.jit
+def _gate_up(X, W, S, IDS, POS, A, H: tl.constexpr, I: tl.constexpr,
+             TOPK: tl.constexpr, NEXP: tl.constexpr, LIMIT: tl.constexpr, BN: tl.constexpr):
+    r = tl.program_id(0)
+    pos = tl.load(POS + r).to(tl.int64)
+    expert = tl.load(IDS + pos).to(tl.int64)
+    col = tl.program_id(1) * BN + tl.arange(0, BN)
+    lane = tl.arange(0, 8)
+    perm = tl.where(lane < 4, lane * 2, (lane - 4) * 2 + 1)
+    if expert >= 0 and expert < NEXP:
+        ge = tl.full((BN, 8), 0., tl.float32)
+        go = tl.full((BN, 8), 0., tl.float32)
+        ue = tl.full((BN, 8), 0., tl.float32)
+        uo = tl.full((BN, 8), 0., tl.float32)
+        for group in range(H // 32):
+            gg = tl.full((BN, 8), 0., tl.float32)
+            ug = tl.full((BN, 8), 0., tl.float32)
+            for q in tl.static_range(4):
+                k = group * 32 + q * 8 + perm
+                x = tl.load(X + (pos // TOPK) * H + k).to(tl.float32)
+                gp = tl.load(W + expert * (2 * I * H // 2) + col[:, None] * (H // 2) + k[None, :] // 2,
+                             mask=col[:, None] < I, other=0).to(tl.int32)
+                up = tl.load(W + expert * (2 * I * H // 2) + (I + col[:, None]) * (H // 2) + k[None, :] // 2,
+                             mask=col[:, None] < I, other=0).to(tl.int32)
+                gw = _fp4((gp >> ((k[None, :] & 1) * 4)) & 15)
+                uw = _fp4((up >> ((k[None, :] & 1) * 4)) & 15)
+                if q == 0:
+                    gg = x[None, :] * gw
+                    ug = x[None, :] * uw
+                else:
+                    gg = tl.fma(x[None, :], gw, gg)
+                    ug = tl.fma(x[None, :], uw, ug)
+            gs = tl.load(S + expert * (2 * I * H // 32) + col * (H // 32) + group, col < I, other=127).to(tl.int32)
+            us = tl.load(S + expert * (2 * I * H // 32) + (I + col) * (H // 32) + group, col < I, other=127).to(tl.int32)
+            gs = tl.where(gs == 0, 0.5 * (1.1754943508222875e-38), (gs << 23).to(tl.float32, bitcast=True))
+            us = tl.where(us == 0, 0.5 * (1.1754943508222875e-38), (us << 23).to(tl.float32, bitcast=True))
+            if group % 2 == 0:
+                ge = tl.fma(gg, gs[:, None], ge)
+                ue = tl.fma(ug, us[:, None], ue)
+            else:
+                go = tl.fma(gg, gs[:, None], go)
+                uo = tl.fma(ug, us[:, None], uo)
+        g = _sum8(ge + go, BN).to(tl.bfloat16).to(tl.float32)
+        u = _sum8(ue + uo, BN).to(tl.bfloat16).to(tl.float32)
+        a = _activation(g, u, LIMIT).to(tl.bfloat16)
+    else:
+        a = tl.full((BN,), 0., tl.bfloat16)
+    tl.store(A + r * I + col, a, col < I)
+
+
+@triton.jit
+def _down(A, W, S, IDS, POS, OUT, H: tl.constexpr, I: tl.constexpr,
+          NEXP: tl.constexpr, PARTS: tl.constexpr, BN: tl.constexpr):
+    r = tl.program_id(0)
+    pos = tl.load(POS + r).to(tl.int64)
+    expert = tl.load(IDS + pos).to(tl.int64)
+    col = tl.program_id(1) * BN + tl.arange(0, BN)
+    lane = tl.arange(0, 8)
+    perm = tl.where(lane < 4, lane * 2, (lane - 4) * 2 + 1)
+    if expert >= 0 and expert < NEXP:
+        result = tl.full((BN,), 0., tl.float32)
+        for part in range(PARTS):
+            even = tl.full((BN, 8), 0., tl.float32)
+            odd = tl.full((BN, 8), 0., tl.float32)
+            for group in range(I // PARTS // 32):
+                acc = tl.full((BN, 8), 0., tl.float32)
+                for q in tl.static_range(4):
+                    k = part * (I // PARTS) + group * 32 + q * 8 + perm
+                    a = tl.load(A + r * I + k).to(tl.float32)
+                    packed = tl.load(W + expert * (H * I // 2) + col[:, None] * (I // 2) + k[None, :] // 2,
+                                     mask=col[:, None] < H, other=0).to(tl.int32)
+                    w = _fp4((packed >> ((k[None, :] & 1) * 4)) & 15)
+                    if q == 0: acc = a[None, :] * w
+                    else: acc = tl.fma(a[None, :], w, acc)
+                scale = tl.load(S + expert * (H * I // 32) + col * (I // 32) + part * (I // PARTS // 32) + group,
+                                col < H, other=127).to(tl.int32)
+                scale = tl.where(scale == 0, 0.5 * (1.1754943508222875e-38), (scale << 23).to(tl.float32, bitcast=True))
+                if group % 2 == 0: even = tl.fma(acc, scale[:, None], even)
+                else: odd = tl.fma(acc, scale[:, None], odd)
+            value = _sum8(even + odd, BN).to(tl.bfloat16).to(tl.float32)
+            result = result + value
+        tl.store(OUT + pos * H + col, result.to(tl.bfloat16), col < H)
+
+
+@triton.jit
+def _combine(ROUTES, WEIGHTS, OUT, H: tl.constexpr, TOPK: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    col = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.full((BLOCK,), 0., tl.float32)
+    for j in tl.static_range(TOPK):
+        w = tl.load(WEIGHTS + row * TOPK + j).to(tl.float32)
+        v = tl.load(ROUTES + (row * TOPK + j) * H + col, col < H, other=0.).to(tl.float32)
+        acc = tl.fma(v, w, acc)
+    tl.store(OUT + row * H + col, acc.to(tl.bfloat16), col < H)
+
+
+def expert_routes(x, w13, s13, w2, s2, ids, weights, *, out=None, parts=8, limit=10.):
+    """Write only owned live routes; caller zero-initializes a shared output.
+
+    Inputs are contiguous original packed MXFP4/E8M0 tensors. CPU must emit
+    the same *unweighted* per-route representation before combine_routes.
+    """
+    if x.dtype != torch.bfloat16 or ids.ndim != 2 or weights.shape != ids.shape:
+        raise ValueError('canonical MXFP4 requires BF16 activations and paired 2D routes')
+    T, H = x.shape
+    E, N2, Kp = w13.shape
+    I = N2 // 2
+    if parts != 8 or H % 32 or I % (parts * 32) or Kp * 2 != H:
+        raise ValueError('canonical MXFP4 requires eight aligned CPU partitions')
+    if w2.shape != (E,H,I//2) or s13.shape != (E,2*I,H//32) or s2.shape != (E,H,I//32):
+        raise ValueError('canonical MXFP4 payload shape mismatch')
+    if ids.shape[0] != T or weights.dtype != torch.float32:
+        raise ValueError('canonical MXFP4 route shape/dtype mismatch')
+    for tensor in (x,w13,s13,w2,s2,ids,weights):
+        if not tensor.is_cuda or tensor.device != x.device or not tensor.is_contiguous():
+            raise ValueError('canonical MXFP4 inputs must be contiguous on one CUDA device')
+    if any(t.dtype != torch.uint8 for t in (w13,s13,w2,s2)):
+        raise ValueError('canonical MXFP4 payloads must contain original uint8 bytes')
+    K = ids.shape[1]
+    if out is None: out = torch.zeros((T,K,H),dtype=torch.bfloat16,device=x.device)
+    elif out.shape != (T,K,H) or out.dtype != torch.bfloat16 or out.device != x.device or not out.is_contiguous():
+        raise ValueError('canonical MXFP4 route output mismatch')
+    if torch.cuda.is_current_stream_capturing():
+        pos = torch.arange(T*K,dtype=torch.int64,device=x.device)
+        # Invalid or zero-weight routes must remain untouched in a shared output.
+        ids = torch.where(weights != 0, ids, -1).contiguous()
+    else:
+        pos = ((weights.reshape(-1)!=0)&(ids.reshape(-1)>=0)&(ids.reshape(-1)<E)).nonzero().flatten()
+    R = pos.numel()
+    if R:
+        a = torch.empty((R,I),dtype=torch.bfloat16,device=x.device)
+        options=dict(num_warps=4,enable_fp_fusion=False)
+        _gate_up[(R,triton.cdiv(I,32))](x,w13,s13,ids,pos,a,H,I,K,E,limit,32,**options)
