diff --git a/python/sglang/srt/mem_cache/kt_hicache_trace.py b/python/sglang/srt/mem_cache/kt_hicache_trace.py
new file mode 100644
index 0000000..cf66ad8
--- /dev/null
+++ b/python/sglang/srt/mem_cache/kt_hicache_trace.py
@@ -0,0 +1,157 @@
+"""HiCache tracing for the DeepSeek V4 host tier (KT_HICACHE_TRACE=1; optional prefix policy).
+
+Installed by the DeepSeek V4 HiCache stack builder (prefix-cache-policy patch). Off by
+default: install() returns at once and nothing is wrapped. On, it wraps a few
+methods of the one UnifiedRadixCache instance and prints a line for each event
+that decides whether an evicted prefix can come back from host memory:
+
+- match: a prefix lookup of at least KT_HICACHE_TRACE_MIN tokens (default 4096):
+  device hit, host hit (FULL), SWA host hit, full-KV path length, and the free
+  host pages of the KV (logical anchor) and SWA pools;
+- backup-fail: a write-through D->H backup that could not get host pages;
+- evict-host: host-pool reclaim (which component, asked, freed);
+- load-back: an H->D reload attempt and whether it was committed;
+- evict-leaf: a device-leaf eviction that deleted an unbacked node (its KV is
+  gone) instead of demoting it to host.
+
+Only reads state and counts; it never changes what the cache does.
+"""
+import os
+import time
+
+ENABLED = os.environ.get("KT_HICACHE_TRACE", "0") == "1"
+MIN_TOKENS = 4096
+if ENABLED:
+    try:
+        MIN_TOKENS = int(os.environ.get("KT_HICACHE_TRACE_MIN", "4096"))
+    except ValueError as exc:
+        raise ValueError("KT_HICACHE_TRACE_MIN must be a nonnegative integer") from exc
+    if MIN_TOKENS < 0:
+        raise ValueError("KT_HICACHE_TRACE_MIN must be a nonnegative integer")
+STATS = {"match": 0, "backup_ok": 0, "backup_fail": 0, "backup_tokens": 0,
+         "evict_host_calls": 0, "evict_host_freed": {}, "load_ok": 0, "load_fail": 0,
+         "leaf_demote": 0, "leaf_delete": 0, "leaf_delete_tokens": 0}
+
+
+def _log(msg: str) -> None:
+    print(f"[kt-hicache {time.strftime('%H:%M:%S')}] {msg}", flush=True)
+
+
+def _free_pages(cache) -> str:
+    """'kv=<free tokens> swa=<free tokens>' of the host pools, best effort."""
+    parts = []
+    try:
+        parts.append(f"kv={cache.cache_controller.mem_pool_host.available_size()}")
+    except Exception:
+        parts.append("kv=?")
+    try:
+        group = cache.host_pool_group
+        for name, entry in group.entry_map.items():
+            if str(name).lower().endswith("swa"):
+                parts.append(f"swa={entry.host_pool.available_size()}")
+    except Exception:
+        pass
+    return " ".join(parts)
+
+
+def _key_len(params) -> int:
+    key = getattr(params, "key", None)
+    try:
+        return len(key) if key is not None else 0
+    except Exception:
+        return 0
+
+
+def install(cache) -> bool:
+    """Wrap the cache's methods (instance attributes). Returns whether it did."""
+    if not ENABLED or getattr(cache, "_kt_hicache_trace", False):
+        return False
+    cache._kt_hicache_trace = True
+
+    orig_match = cache.match_prefix
+
+    def match_prefix(params, *a, **kw):
+        result = orig_match(params, *a, **kw)
+        n = _key_len(params)
+        if n >= MIN_TOKENS:
+            STATS["match"] += 1
+            _log(f"match {n} tokens: device {getattr(result, 'device_prefix_len', '?')}, "
+                 f"host {getattr(result, 'host_hit_length', '?')}, "
+                 f"swa host {getattr(result, 'swa_host_hit_length', '?')}, "
+                 f"full-kv path {getattr(result, 'full_kv_hit_length', '?')}; free host {_free_pages(cache)}")
+        return result
+
+    cache.match_prefix = match_prefix
+
+    if hasattr(cache, "_execute_kv_backup"):
