+    def ttl_sweep(self) -> int:
+        """Free every expired, unlocked device leaf, and the ancestors that become expired
+        leaves on the way, through the normal eviction walk (frees, SWA cascade, HiCache
+        demote and metrics as under pressure). The walk pops expired leaves first (the
+        TTLStrategy key) and stops as soon as no expired evictable leaf is left, so a live
+        node is never taken. Returns the Full tokens freed."""
+        ttl = self._cache_ttl
+        if ttl is None or self.disable:
+            return 0
+        core = self.tree_core
+        leaves = core.evictable_device_leaves
+        full = self.components[BASE_COMPONENT_TYPE]
+        held = (
+            (lambda n: full.session_ref(n) > 0)
