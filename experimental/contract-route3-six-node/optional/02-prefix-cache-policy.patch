+            ok = orig_load(node_id, mem_quota, req=req)
+            STATS["load_ok" if ok else "load_fail"] += 1
+            _log(f"load-back node {node_id}: {'committed' if ok else 'declined'} (quota {mem_quota}); "
+                 f"{STATS['load_ok']} ok, {STATS['load_fail']} declined")
+            return ok
+
+        cache.load_back = load_back
