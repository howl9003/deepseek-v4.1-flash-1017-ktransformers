+
+# ---- SGLANG_CACHE_TTL=1: prefix-cache expiry by request class ------------------
+# Default off: nothing below is used and the cache is today's pure policy (LRU here).
+import math as _math
+import os as _os
+import time as _time
+from typing import Any as _Any
+from typing import Optional as _Optional
+
+CACHE_CLASS_USER = "user"
+CACHE_CLASS_AGENT = "agent"
+CACHE_CLASSES = (CACHE_CLASS_USER, CACHE_CLASS_AGENT)
+# The class travels in the request's KV-hint envelope (managers/kv_hints.py) as one action of
+# this type with payload {"class": "agent" | "user"}; consumers ignore types they do not know.
+CACHE_CLASS_HINT_TYPE = "cache_class"
+CACHE_CLASS_HINT_VERSION = "1"
+
+
+def cache_ttl_enabled() -> bool:
+    return _os.environ.get("SGLANG_CACHE_TTL", "0") == "1"
+
+
+def normalize_cache_class(value: _Any) -> _Optional[str]:
+    """'agent' / 'user' (case and blanks ignored); None for None or ''; ValueError otherwise."""
+    if value is None:
+        return None
+    v = str(value).strip().lower()
+    if not v:
+        return None
+    if v not in CACHE_CLASSES:
+        raise ValueError(f"cache class must be one of {CACHE_CLASSES}, got {value!r}")
+    return v
+
+
+def cache_class_from_kv_hints(kv_hints: _Any) -> _Optional[str]:
+    """The class a KV-hint envelope names (its last cache_class action), else None."""
+    found = None
+    for action in getattr(kv_hints, "actions", None) or ():
+        if getattr(action, "action_type", None) != CACHE_CLASS_HINT_TYPE:
+            continue
+        try:
+            found = normalize_cache_class((getattr(action, "payload", None) or {}).get("class"))
+        except (ValueError, AttributeError):
+            found = None
+    return found
+
+
+def cache_class_of_req(req: _Any) -> _Optional[str]:
+    if req is None:
+        return None
+    return cache_class_from_kv_hints(getattr(req, "kv_hints", None))
+
+
+def with_cache_class_hint(kv_hints: _Any, cache_class: str, message_id: _Optional[str] = None):
+    """kv_hints (None, a dict or an envelope) with its cache_class action set to cache_class."""
+    from sglang.srt.managers.kv_hints import (
+        KvHintAction,
+        KvHintsEnvelope,
+        decode_kv_hints_envelope,
+    )
+
+    action = KvHintAction(
+        action_id=CACHE_CLASS_HINT_TYPE,
+        action_type=CACHE_CLASS_HINT_TYPE,
+        action_version=CACHE_CLASS_HINT_VERSION,
+        payload={"class": cache_class},
+    )
+    if not kv_hints:
+        return KvHintsEnvelope(
+            protocol_version="1", message_id=message_id or "cache-class", actions=[action]
+        )
+    env = decode_kv_hints_envelope(kv_hints)
+    keep = [a for a in env.actions if a.action_type != CACHE_CLASS_HINT_TYPE]
+    return KvHintsEnvelope(
+        protocol_version=env.protocol_version, message_id=env.message_id, actions=keep + [action]
+    )
+
+
+class CacheTTLPolicy:
+    """Inactivity expiry for radix nodes by request class.
+
+    A node keeps one monotonic stamp per class (``_ttl_agent_ts`` / ``_ttl_user_ts``: the
+    newest access by that class). Its deadline is the later of agent_ts + agent_s and
+    user_ts + user_s over the classes that touched it, so a node touched by both keeps the
+    longer life; it is expired once the clock is past that deadline. ``clock`` is injectable
+    (tests use a fake one)."""
+
+    def __init__(self, agent_s=1800.0, user_s=43200.0, sweep_s=60.0, relend_tokens=0, clock=None):
+        self.agent_s = float(agent_s)
+        self.user_s = float(user_s)
+        self.sweep_s = float(sweep_s)
+        self.relend_tokens = int(relend_tokens)
+        for name in ("agent_s", "user_s", "sweep_s"):
+            value = getattr(self, name)
+            if not _math.isfinite(value) or value <= 0:
+                raise ValueError(f"cache TTL {name} must be finite and positive")
+        if self.relend_tokens < 0:
+            raise ValueError("cache TTL relend_tokens must be nonnegative")
+        self.clock = clock or _time.monotonic
+        self.next_sweep = None
+        self.sweep_on = True
+        self.relend_from = None  # slots the hot lend held when a relend gave them back
+        self.stats = {"sweeps": 0, "swept_tokens": 0, "swept_nodes": 0, "relends": 0}
+
+    @classmethod
+    def from_env(cls):
+        if not cache_ttl_enabled():
+            return None
+        env = _os.environ
+        return cls(
+            agent_s=float(env.get("SGLANG_CACHE_TTL_AGENT_S", "1800") or 1800),
+            user_s=float(env.get("SGLANG_CACHE_TTL_USER_S", "43200") or 43200),
+            sweep_s=float(env.get("SGLANG_CACHE_TTL_SWEEP_S", "60") or 60),
+            relend_tokens=int(env.get("SGLANG_CACHE_TTL_RELEND_TOKENS", "0") or 0),
+        )
+
+    def describe(self) -> str:
+        return (
+            f"agent {self.agent_s:g} s, user {self.user_s:g} s, sweep every {self.sweep_s:g} s"
+            + (f", hot relend at >= {self.relend_tokens} tokens freed" if self.relend_tokens else "")
+        )
+
+    def stamp_path(self, node, root, cache_class: str, now=None) -> None:
+        """Stamp node and its ancestors (root excluded) as accessed by cache_class now."""
+        now = self.clock() if now is None else now
+        attr = "_ttl_agent_ts" if cache_class == CACHE_CLASS_AGENT else "_ttl_user_ts"
+        while node is not None and node is not root:
+            # A newly split parent must inherit the old path's other class
+            # before this access gives it its first stamp. Otherwise an agent
+            # hit could shorten a user's existing lifetime on the shared part.
+            self._inherit_child_stamps(node)
+            setattr(node, attr, now)
+            node = node.parent
+
+    def _inherit_child_stamps(self, node) -> None:
+        """Resolve unstamped split fragments without inventing a user access."""
+        order, stack = [], [node]
+        while stack:
+            current = stack.pop()
+            if (getattr(current, "_ttl_agent_ts", None) is None
+                    and getattr(current, "_ttl_user_ts", None) is None):
+                order.append(current)
+                stack.extend(getattr(current, "children", {}).values())
+        for current in reversed(order):
+            for attr in ("_ttl_agent_ts", "_ttl_user_ts"):
+                stamps = [getattr(child, attr, None)
+                          for child in getattr(current, "children", {}).values()]
+                stamps = [stamp for stamp in stamps if stamp is not None]
+                if stamps:
+                    setattr(current, attr, max(stamps))
+
+    def deadline(self, node, now) -> float:
+        agent = getattr(node, "_ttl_agent_ts", None)
+        user = getattr(node, "_ttl_user_ts", None)
+        if agent is None and user is None:
+            # Unstamped: a split fragment past the refreshed path, or a node an internal path
+            # made. Inherit the children's newest stamps (a split parent's child holds the
+            # original's), else count it a user access now (the conservative class).
+            self._inherit_child_stamps(node)
+            agent = getattr(node, "_ttl_agent_ts", None)
+            user = getattr(node, "_ttl_user_ts", None)
+            if agent is None and user is None:
+                user = now
+            node._ttl_agent_ts, node._ttl_user_ts = agent, user
+        d = -_math.inf
+        if agent is not None:
+            d = agent + self.agent_s
+        if user is not None:
+            d = max(d, user + self.user_s)
+        return d
+
+    def resolve_unstamped(self, root, now) -> int:
+        """Stamp every unstamped node, children first, so a split fragment inherits from the
+        child it was cut off before that child can be evicted. O(nodes), once a sweep."""
+        order, stack = [], [root]
+        while stack:
+            node = stack.pop()
+            order.append(node)
+            stack.extend(node.children.values())
+        count = 0
+        for node in reversed(order):  # every child before its parent
+            if node is root:
+                continue
+            if getattr(node, "_ttl_agent_ts", None) is None and getattr(node, "_ttl_user_ts", None) is None:
+                self.deadline(node, now)
+                count += 1
+        return count
+
+    def is_expired(self, node, now=None) -> bool:
+        now = self.clock() if now is None else now
+        return now > self.deadline(node, now)
+
+
+class TTLStrategy(EvictionStrategy):
+    """Expired nodes first, then the wrapped policy's order (LRU on this stack)."""
+
+    def __init__(self, inner: EvictionStrategy, policy: CacheTTLPolicy):
+        self.inner = inner
+        self.policy = policy
+
+    def get_priority(self, node):
+        return (0 if self.policy.is_expired(node) else 1, self.inner.get_priority(node))
+
+    def __getattr__(self, name):
+        # policy knobs other code reads off the strategy (e.g. TLRU's threshold)
+        return getattr(self.__dict__["inner"], name)
